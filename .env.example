# ============================================================
# CONFIGURAÇÕES DO SISTEMA - LISTA DE FESTA
# ============================================================
# Copie este arquivo para .env e preencha com seus dados

# URL pública do servidor (necessária para webhook do Mercado Pago)
# Exemplo: https://meuevento.com ou use ngrok para testes locais
BASE_URL=https://seudominio.com

# Porta do servidor
PORT=3000

# ---- MERCADO PAGO ----
# Acesse: https://www.mercadopago.com.br/developers/panel/app
# Copie o Access Token de PRODUÇÃO (começa com APP_USR-...)
# Para testes, use o Access Token de SANDBOX (começa com TEST-...)
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- EVENTO ----
EVENT_NAME=Nome do Meu Evento
EVENT_DATE=2024-12-31
EVENT_LOCATION=Local do Evento, Cidade - UF
EVENT_PRICE=50.00

# ---- ADMIN ----
# Senha para acessar o painel administrativo
ADMIN_PASSWORD=admin123
